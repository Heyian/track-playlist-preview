{
  "name": "track-playlist-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Spicetify extension restoring Spotify's removed track preview, extended to whole playlists, albums, artists and Liked Songs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heyian/track-playlist-preview.git"
  },
  "author": "Heyian",
  "license": "MIT",
  "type": "module",
  "spicetify": {
    "dependencies": {
      "stdlib": "^1.13.0"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:local": "bun run build.ts --local",
    "watch": "bun run build.ts --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "check:dist": "bun scripts/checkDist.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
